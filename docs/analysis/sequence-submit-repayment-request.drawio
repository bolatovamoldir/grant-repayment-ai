        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam classAttributeIconSize 0\nskinparam class {\n  BackgroundColor White\n  BorderColor Black\n}\nskinparam ArrowColor Black\nskinparam linetype ortho\nskinparam nodesep 60\nskinparam ranksep 70\n\ntitle Class Diagram: Курьерлік жеткізу жүйесі\n\nclass Тұлға {\n  - аты : String\n  - телефон : String\n}\n\nclass Клиент {\n  - клиентID : int\n  + тапсырысБеру() : ЖеткізуТапсырысы\n  + сәлемдемеБақылау(трекингКод : String) : String\n}\n\nclass Курьер {\n  - курьерID : int\n  - статус : String\n  + статусЖаңарту(жаңаСтатус : String) : Boolean\n}\n\nclass ЖеткізуТапсырысы {\n  - тапсырысID : int\n  - трекингКод : String\n  - статус : String\n  + болдырмау(себеп : String) : Boolean\n  + құнынЕсептеу() : double\n}\n\nclass Сәлемдеме {\n  - сәлемдемеID : int\n  - салмағы : double\n  - сипаттамасы : String\n  + салмағынАлу() : double\n}\n\nclass Маршрут {\n  - бастапқыМекенжай : String\n  - соңғыМекенжай : String\n  + арақашықтықтыАлу() : double\n}\n\nclass БақылауОқиғасы {\n  - оқиғаID : int\n  - уақыты : Date\n  - орналасқанЖері : String\n  + оқиғаныТіркеу() : void\n}\n\n&#39; Мұрагерлік\nТұлға &lt;|-- Клиент\nТұлға &lt;|-- Курьер\n\n&#39; Ассоциациялар (екі шетінде еселік)\nКлиент \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ЖеткізуТапсырысы : таратады\nКурьер \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ЖеткізуТапсырысы : жауапты\nЖеткізуТапсырысы \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Маршрут : қамтиды\n\n&#39; Агрегация: ромб бүтін жағында (ЖеткізуТапсырысы)\nЖеткізуТапсырысы \&quot;1\&quot; o-- \&quot;1\&quot; Сәлемдеме : тұрады\n\n&#39; Композиция: ромб бүтін жағында (ЖеткізуТапсырысы)\nЖеткізуТапсырысы \&quot;1\&quot; *-- \&quot;1..*\&quot; БақылауОқиғасы : тіркейді\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="bkzesAJv2i9Do0zVBTF_-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
