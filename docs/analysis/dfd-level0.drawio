quests : \&quot;1:N жіберіледі\&quot;\nusers ||--o{ requests : \&quot;1:N тексереді\&quot;\nrequests ||--o{ predictions : \&quot;1:N бағаланады\&quot;\nusers ||--o{ grad_orgs : \&quot;1:N (M:N аралық)\&quot;\norgs ||--o{ grad_orgs : \&quot;1:N (M:N аралық)\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AiL3hHS9ubbMMAEQH4OE-1">
